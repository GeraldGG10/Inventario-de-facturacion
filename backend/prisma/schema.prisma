generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           String   @id @default(uuid())
  nombre       String
  email        String   @unique
  passwordHash String   @map("password_hash")
  rolId        String   @map("rol_id")
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  rol           Rol            @relation(fields: [rolId], references: [id])
  refreshTokens RefreshToken[]
  auditorias    Auditoria[]

  @@map("usuarios")
}

model Rol {
  id     String @id @default(uuid())
  nombre String @unique

  usuarios    Usuario[]
  permisos    RolPermiso[]

  @@map("roles")
}

model Permiso {
  id          String @id @default(uuid())
  nombre      String @unique
  descripcion String?

  roles RolPermiso[]

  @@map("permisos")
}

model RolPermiso {
  rolId     String @map("rol_id")
  permisoId String @map("permiso_id")

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("rol_permisos")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  usuarioId String   @map("usuario_id")
  revocado  Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Auditoria {
  id            String   @id @default(uuid())
  usuarioId     String?  @map("usuario_id")
  accion        String
  entidad       String
  entidadId     String?  @map("entidad_id")
  datosAntes    Json?    @map("datos_antes")
  datosDespues  Json?    @map("datos_despues")
  timestamp     DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@map("auditoria")
  @@index([entidad, entidadId])
  @@index([usuarioId])
}

// ============================================================================
// MODELOS PROPUESTOS — Módulo 3 (Dashboard)
// ============================================================================
// Contrato de datos NO VALIDADO todavía con el equipo de Inventario/Facturación.
// Ver docs/SCHEMA_DASHBOARD.md para el detalle y las preguntas abiertas.
//
// Estos modelos existen solo para que las queries de agregación del dashboard
// tengan un contrato de referencia mientras se confirma el esquema real. NO
// correr `prisma migrate` con este bloque contra una base compartida: cuando
// Inventario/Facturación definan su propio schema.prisma (o esta sección se
// alinee con el suyo), este bloque debe eliminarse o reconciliarse para evitar
// modelos/tablas duplicados. Los endpoints de /dashboard construidos sobre
// este contrato usan datos mock en memoria, no consultas reales a estas tablas.
// ============================================================================

model Cliente {
  id     String @id @default(uuid())
  nombre String

  facturas Factura[]

  @@map("clientes_dashboard_propuesto")
}

model Producto {
  id          String @id @default(uuid())
  nombre      String
  costo       Decimal @db.Decimal(10, 2)
  precio      Decimal @db.Decimal(10, 2)
  stockActual Int     @map("stock_actual")
  stockMinimo Int     @map("stock_minimo")

  detalles    DetalleFactura[]
  movimientos MovimientoInventario[]

  @@map("productos_dashboard_propuesto")
}

model Factura {
  id        String   @id @default(uuid())
  clienteId String   @map("cliente_id")
  fecha     DateTime
  subtotal  Decimal  @db.Decimal(10, 2)
  impuestos Decimal  @db.Decimal(10, 2)
  total     Decimal  @db.Decimal(10, 2)
  anulada   Boolean  @default(false)

  cliente  Cliente          @relation(fields: [clienteId], references: [id])
  detalles DetalleFactura[]

  @@map("facturas_dashboard_propuesto")
}

model DetalleFactura {
  id             String  @id @default(uuid())
  facturaId      String  @map("factura_id")
  productoId     String  @map("producto_id")
  cantidad       Int
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(10, 2)
  costoUnitario  Decimal @map("costo_unitario") @db.Decimal(10, 2)

  factura  Factura  @relation(fields: [facturaId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  @@map("detalle_factura_dashboard_propuesto")
}

enum TipoMovimientoInventario {
  entrada
  salida
  ajuste
}

model MovimientoInventario {
  id         String                    @id @default(uuid())
  productoId String                    @map("producto_id")
  tipo       TipoMovimientoInventario
  cantidad   Int
  fecha      DateTime                  @default(now())

  producto Producto @relation(fields: [productoId], references: [id])

  @@map("movimientos_inventario_dashboard_propuesto")
}
