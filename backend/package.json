{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc && npm run build:seed",
    "build:seed": "tsc prisma/seed.ts --outDir dist/prisma --module commonjs --target ES2020 --esModuleInterop --skipLibCheck --resolveJsonModule",
    "start": "node dist/index.js",
    "seed:demo": "ts-node prisma/seed-demo.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^3.0.3",
    "brotli": "^1.3.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "es-abstract": "^1.24.2",
    "es-get-iterator": "^1.1.3",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "@types/pdfkit": "^0.13.4",
    "prisma": "^5.20.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "bin": "dist/index.js",
  "pkg": {
    "scripts": [
      "dist/**/*.js",
      "node_modules/es-get-iterator/**/*.js",
      "node_modules/es-get-iterator/package.json"
    ],
    "assets": [
      "prisma/schema.prisma",
      "node_modules/**/*",
      "../frontend/dist/**/*"
    ],
    "targets": [
      "node16-win-x64"
    ]
  }
}
