# ──────────────────────────────────────────────
# BASE DE DATOS — PostgreSQL local
# Cambia "tecnolaser2026" por la contraseña que pusiste al instalar PostgreSQL.
# Si esta máquina YA tiene otro PostgreSQL instalado (puerto 5432 ocupado),
# cambia el puerto aquí (ej. 5433) — el motor portable de Tecno-laser lo toma
# automáticamente de esta misma URL, no hace falta tocar nada más.
# ──────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:tecnolaser2026@localhost:5432/tecnolaser?schema=public"

# ──────────────────────────────────────────────
# SERVIDOR — LAN
# Puerto donde escucha el backend (todas las IPs de la máquina)
# ──────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0

# ──────────────────────────────────────────────
# JWT — Cambia estos secretos en producción
# ──────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
